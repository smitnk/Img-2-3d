# Minimal Ubuntu 24.04 aarch64 userland that the Android app runs Blender in (via proot).
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
COPY pkgs.txt /tmp/pkgs.txt
# Mesa EGL + llvmpipe: software OpenGL 4.5 so render engines, the gpu module and GPU-backed ops work without a
# GPU driver (Android exposes none to Linux userlands). Selected at run time via EGL_PLATFORM=surfaceless.
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-numpy $(cat /tmp/pkgs.txt) \
    libegl1 libegl-mesa0 libgl1-mesa-dri libgbm1 \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/locale /var/cache/* /usr/share/info /tmp/pkgs.txt
COPY --from=blender-build /usr/local/lib /usr/local/lib
RUN ldconfig
COPY --from=blender-build /opt/blender /opt/blender
COPY forge /opt/forge
