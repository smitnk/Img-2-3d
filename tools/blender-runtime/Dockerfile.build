# Builds Blender 4.2.3 LTS headless for linux-aarch64 against Ubuntu 24.04 system libraries.
FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git ca-certificates pkg-config \
    python3-dev python3-numpy python3-requests libpython3-dev \
    libtbb-dev libboost-all-dev libopenimageio-dev libopencolorio-dev libopenexr-dev libimath-dev \
    libosd-dev libopenvdb-dev libblosc-dev libpotrace-dev libfftw3-dev libzstd-dev libgmp-dev \
    libjpeg-dev libpng-dev libtiff-dev libwebp-dev libfreetype-dev libepoxy-dev libpugixml-dev \
    libxml2-dev libyaml-cpp-dev zlib1g-dev libeigen3-dev libharfbuzz-dev libfribidi-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 -b v4.2.3 https://github.com/blender/blender.git /src
WORKDIR /build
RUN cmake /src -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/blender \
    -DWITH_INSTALL_PORTABLE=ON -DWITH_HEADLESS=ON -DWITH_GHOST_X11=OFF -DWITH_GHOST_WAYLAND=OFF \
    -DWITH_CYCLES=OFF -DWITH_AUDASPACE=OFF -DWITH_OPENAL=OFF -DWITH_SDL=OFF -DWITH_JACK=OFF -DWITH_PULSEAUDIO=OFF \
    -DWITH_CODEC_FFMPEG=OFF -DWITH_CODEC_SNDFILE=OFF -DWITH_ALEMBIC=OFF -DWITH_USD=OFF -DWITH_MATERIALX=OFF \
    -DWITH_HYDRA=OFF -DWITH_OPENIMAGEDENOISE=OFF -DWITH_IO_WAVEFRONT_OBJ=ON -DWITH_IO_STL=ON \
    -DWITH_OPENSUBDIV=ON -DWITH_OPENVDB=ON -DWITH_OPENVDB_BLOSC=ON -DWITH_QUADRIFLOW=ON -DWITH_MOD_REMESH=ON \
    -DWITH_MANIFOLD=OFF -DWITH_MOD_FLUID=OFF -DWITH_MOD_OCEANSIM=OFF -DWITH_INPUT_NDOF=OFF -DWITH_INPUT_IME=OFF \
    -DWITH_LIBMV=OFF -DWITH_FREESTYLE=OFF -DWITH_INTERNATIONAL=OFF -DWITH_XR_OPENXR=OFF -DWITH_VULKAN_BACKEND=OFF \
    -DWITH_PYTHON_INSTALL=OFF -DWITH_PYTHON_INSTALL_NUMPY=OFF -DWITH_PYTHON_INSTALL_REQUESTS=OFF \
    -DPYTHON_VERSION=3.12 -DWITH_COMPOSITOR_CPU=ON -DWITH_TESTS=OFF \
    && ninja -j"$(nproc)" install
